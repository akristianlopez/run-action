{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect to Docker (knb-shell)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 40000,
            "host": "localhost",
            // "remotePath": "./app/knb-shell-debug",
            "debugAdapter": "legacy",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}/",
                    "to": "/app/"
                }
            ]
        }
    ]
}